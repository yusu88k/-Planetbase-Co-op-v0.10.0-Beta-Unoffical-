<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>7.3</LangVersion>
    <AssemblyName>PlanetbaseCoop</AssemblyName>
    <RootNamespace>PlanetbaseCoop</RootNamespace>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <PlanetbaseManagedPath Condition="'$(PlanetbaseManagedPath)' == ''">..\..\Planetbase_Data\Managed</PlanetbaseManagedPath>
    <BepInExCorePath Condition="'$(BepInExCorePath)' == ''">..\..\BepInEx\core</BepInExCorePath>
    <SteamworksManagedPath Condition="'$(SteamworksManagedPath)' == ''">lib\Steamworks.NET\Steamworks.NET.dll</SteamworksManagedPath>
    <SteamworksReferenceName Condition="'$(SteamworksReferenceName)' == ''">Steamworks.NET</SteamworksReferenceName>
    <CopySteamworksManaged Condition="'$(CopySteamworksManaged)' == ''">true</CopySteamworksManaged>
    <BundleSteamRedistributable Condition="'$(BundleSteamRedistributable)' == ''">true</BundleSteamRedistributable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <!-- BepInEx 5.4.23.x: net48 plugin'leri için 0Harmony20.dll kullanılır -->
    <Reference Include="BepInEx">
      <HintPath>$(BepInExCorePath)\BepInEx.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(BepInExCorePath)\0Harmony20.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- BepInEx'in ürettiği UnityEngine facade'ı (oyun bir kez çalıştırılınca oluşur) -->
    <Reference Include="UnityEngine">
      <HintPath>$(PlanetbaseManagedPath)\UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- Facade, MonoBehaviour vb. tipleri gerçek modüllere yönlendirir -->
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(PlanetbaseManagedPath)\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.InputLegacyModule">
      <HintPath>$(PlanetbaseManagedPath)\UnityEngine.InputLegacyModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.TextRenderingModule">
      <HintPath>$(PlanetbaseManagedPath)\UnityEngine.TextRenderingModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.IMGUIModule">
      <HintPath>$(PlanetbaseManagedPath)\UnityEngine.IMGUIModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.ImageConversionModule">
      <HintPath>$(PlanetbaseManagedPath)\UnityEngine.ImageConversionModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.PhysicsModule">
      <HintPath>$(PlanetbaseManagedPath)\UnityEngine.PhysicsModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.AudioModule">
      <HintPath>$(PlanetbaseManagedPath)\UnityEngine.AudioModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Assembly-CSharp">
      <HintPath>$(PlanetbaseManagedPath)\Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="System.Xml" />
    <Reference Include="$(SteamworksReferenceName)">
      <HintPath>$(SteamworksManagedPath)</HintPath>
      <Private>$(CopySteamworksManaged)</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <Content Include="lib\Steamworks.NET\steam_api.dll" Condition="'$(BundleSteamRedistributable)' == 'true'">
      <Link>steam_api.dll</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="steam_appid.txt">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
